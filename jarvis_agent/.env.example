# Required for online model responses. Keep this file free of real credentials.
OPENAI_API_KEY=
OPENAI_API_BASE=
JARVIS_MODEL=gpt-5-mini

# Set true to exercise the full HTTP contract without an LLM provider.
JARVIS_OFFLINE_MODE=true

# Required when the service is exposed beyond localhost.
JARVIS_WEBHOOK_SHARED_SECRET=

# Friendly service name shown in diagnostics.
JARVIS_SERVICE_NAME=JARVIS
